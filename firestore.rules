rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.updatedAt is number;
    }

    match /leaderboards/{mode}/scores/{uid} {
      function isValidScore(data) {
        return data.keys().hasOnly(['uid', 'displayName', 'value', 'mode', 'achievedAt', 'meta'])
          && data.uid == uid
          && data.mode == mode
          && data.value is number
          && data.value > 0
          && data.value < 100000000
          && data.displayName is string
          && data.displayName.size() > 0
          && data.displayName.size() <= 64
          && data.achievedAt == request.time
          && data.meta.keys().hasOnly(['durationMs', 'maxCombo', 'build', 'version'])
          && data.meta.durationMs is number
          && data.meta.durationMs >= 2000
          && data.meta.maxCombo is number
          && data.meta.maxCombo >= 0
          && data.meta.build is list
          && data.meta.version is string
          && data.value <= data.meta.durationMs * 100;
      }

      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && isValidScore(request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == uid
        && isValidScore(request.resource.data)
        && request.resource.data.value > resource.data.value;
      allow delete: if false;
    }
  }
}
